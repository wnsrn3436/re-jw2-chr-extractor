rmax=string(real(rmax)-1)

if real(rmg)>0{rmg=string(real(rmg)-1); return "g"}
else if real(rmm)>0{rmm=string(real(rmm)-1); return "m"}
else if real(rma)>0{rma=string(real(rma)-1); return "a"}
else if real(rmd)>0{rmd=string(real(rmd)-1); return "d"}
else if real(rmbg)>0{rmbg=string(real(rmbg)-1); return "bg"}
else if real(rmbme)>0{rmbme=string(real(rmbme)-1); return "bme"}
else if real(rmbmf)>0{rmbmf=string(real(rmbmf)-1); return "bmf"}
else if real(rmbge)>0{rmbge=string(real(rmbge)-1); return "bge"}
else if real(rmbgf)>0{rmbgf=string(real(rmbgf)-1); return "bgf"}
else if real(rmrep)>0{rmrep=string(real(rmrep)-1); return "rep"}

