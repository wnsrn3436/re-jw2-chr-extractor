smax=string(real(smax)-1)

if real(sms)>0{sms=string(real(sms)-1); return "s"}
else if real(smm)>0{smm=string(real(smm)-1); return "m"}
else if real(sma)>0{sma=string(real(sma)-1); return "a"}
else if real(sml)>0{sml=string(real(sml)-1); return "l"}
else if real(smd)>0{smd=string(real(smd)-1); return "d"}
else if real(smb)>0{smb=string(real(smb)-1); return "b"}
else if real(smw)>0{smw=string(real(smw)-1); return "w"}
else if real(smr)>0{smr=string(real(smr)-1); return "r"}
else if real(smx)>0{smx=string(real(smx)-1); return "x"}

